# Copy to .env and fill in what you need. The demo works without any of it:
# npm run demo runs both models as test fakes.

# The reflex and the planner share one OpenCode Console key. Leave it unset to
# fall back to the OpenCode credential store on this machine (the key that
# /connect saved). Never commit a real key.
# OPENCODE_API_KEY=

# Reflex: the default runs live when a key resolves, else the test fake.
# REFLEX_PROVIDER=systemone
# Jev models on the console: jev-1.13 (paid) and jev-1.13-free (limited time).
SYSTEMONE_MODEL=jev-1.13-free
SYSTEMONE_ENDPOINT=https://opencode.ai/inference/systemone/v1/systemone

# Planner: a general chat model on an OpenAI-compatible endpoint, same key.
# PLANNER_PROVIDER=chat
PLANNER_MODEL=glm-5.3-flash
PLANNER_BASE_URL=https://opencode.ai/inference/openai/v1
