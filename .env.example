# Copy to .env and fill in what you need. The demo works without any of it:
# npm run demo runs the reflex test fake.

# Reflex provider for the demo: "fake" or "systemone". With a resolvable key,
# the demo runs the live Jev model even without this line.
REFLEX_PROVIDER=fake

# The reflex key. Leave unset to fall back to the OpenCode credential store on
# this machine (the key that /connect saved). Never commit a real key.
# OPENCODE_API_KEY=

# Jev model and endpoint. The console serves jev-1.13 (paid) and jev-1.13-free
# (limited time). A local Ollama with the same contract works too, for example
# http://localhost:11434/v1/systemone with model tev1.
SYSTEMONE_MODEL=jev-1.13-free
SYSTEMONE_ENDPOINT=https://opencode.ai/inference/systemone/v1/systemone
