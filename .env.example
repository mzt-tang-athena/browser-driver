# Copy to .env and fill in. The TypeSafe cloud reflex does not run until the real key is here.
# Until then the demo runs the reflex test fake: npm run demo
TYPESAFE_API_KEY=placeholder-until-the-user-sets-the-real-key
# Model id served on the Jev-compatible /v1/systemone endpoint.
TYPESAFE_MODEL=tev1
# Optional: override the endpoint for a local Ollama with the same API shape.
# TYPESAFE_ENDPOINT=http://localhost:11434/v1/systemone
