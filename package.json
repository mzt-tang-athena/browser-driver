{
  "name": "browser-driver",
  "version": "0.1.0",
  "description": "A browser driver service for agents that browse and act. Playwright acts. A reflex model makes routine decisions. A planner model handles hard steps.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/index.ts",
    "eval": "tsx evals/run.ts",
    "service": "tsx src/service/main.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "browser-driver": "./bin/browser-driver.mjs"
  }
}
